<Window x:Class="ListViewNeighborStatesApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ListView neighbor states">
    <Grid Background="#FAFAFA" RequestedTheme="Light" Padding="24" RowSpacing="16" ColumnSpacing="24">
        <Grid.Resources>
            <SolidColorBrush x:Key="BoxBrush" Color="#EDE7F6" />
            <SolidColorBrush x:Key="PillBrush" Color="#6750A4" />
            <SolidColorBrush x:Key="LineBrush" Color="#C8C8C8" />
            <SolidColorBrush x:Key="HoverBrush" Color="#F5F5F5" />

            <ItemsPanelTemplate x:Key="FlatPanel">
                <ItemsStackPanel AreStickyGroupHeadersEnabled="False" GroupPadding="0" />
            </ItemsPanelTemplate>

            <DataTemplate x:Key="ItemTemplate">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="20,0,16,0" />
            </DataTemplate>

            <!--
                Exp1: the original sample.
                * Straight, inset row lines; hidden at selection boundaries and group ends.
                * Selection box and pill join only within a group.
                * Group headers carry a separator, hidden on the first group.
            -->
            <Style x:Key="Exp1HeaderStyle" TargetType="ListViewHeaderItem">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewHeaderItem">
                            <StackPanel>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="GroupPositionStates">
                                        <VisualState x:Name="FirstGroup">
                                            <VisualState.Setters>
                                                <Setter Target="GroupLine.Visibility" Value="Collapsed" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SubsequentGroup" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="GroupLine" Height="2" Background="{StaticResource LineBrush}" />
                                <TextBlock Text="{Binding Content.Key, RelativeSource={RelativeSource TemplatedParent}}" FontSize="20" FontWeight="Bold"
                                           Foreground="#555555" Margin="20,12,16,8" />
                            </StackPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Exp1ItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid x:Name="Root" Height="44" Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource HoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="UnselectedLayer.Visibility" Value="Collapsed" />
                                                <Setter Target="SelectedLayer.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="UnselectedLayer.Visibility" Value="Collapsed" />
                                                <Setter Target="SelectedLayer.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <VisualState.Setters>
                                                <Setter Target="UnselectedLayer.Visibility" Value="Collapsed" />
                                                <Setter Target="SelectedLayer.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="PreviousItemStates">
                                        <VisualState x:Name="NoPreviousItem" />
                                        <VisualState x:Name="PreviousUnselectedSameGroup" />
                                        <VisualState x:Name="PreviousUnselectedOtherGroup" />
                                        <VisualState x:Name="PreviousSelectedSameGroup">
                                            <VisualState.Setters>
                                                <Setter Target="BoxTop.CornerRadius" Value="0" />
                                                <Setter Target="PillTop.Margin" Value="4,0,0,0" />
                                                <Setter Target="PillTop.CornerRadius" Value="0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PreviousSelectedOtherGroup" />
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="NextItemStates">
                                        <VisualState x:Name="NoNextItem" />
                                        <VisualState x:Name="NextUnselectedSameGroup">
                                            <VisualState.Setters>
                                                <Setter Target="UnselectedLine.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="NextUnselectedOtherGroup" />
                                        <VisualState x:Name="NextSelectedSameGroup">
                                            <VisualState.Setters>
                                                <Setter Target="BoxBottom.CornerRadius" Value="0" />
                                                <Setter Target="PillBottom.Margin" Value="4,0,0,0" />
                                                <Setter Target="PillBottom.CornerRadius" Value="0" />
                                                <Setter Target="SelectedLine.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="NextSelectedOtherGroup" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <!-- Box and pill are split in halves: Previous* owns the top, Next* the bottom. -->
                                <Grid x:Name="SelectedLayer" Grid.RowSpan="2" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Border x:Name="BoxTop" Background="{StaticResource BoxBrush}" CornerRadius="8,8,0,0" />
                                    <Border x:Name="BoxBottom" Grid.Row="1" Background="{StaticResource BoxBrush}" CornerRadius="0,0,8,8" />
                                    <Border x:Name="PillTop" Width="4" HorizontalAlignment="Left" Margin="4,8,0,0"
                                            Background="{StaticResource PillBrush}" CornerRadius="2,2,0,0" />
                                    <Border x:Name="PillBottom" Grid.Row="1" Width="4" HorizontalAlignment="Left" Margin="4,0,0,8"
                                            Background="{StaticResource PillBrush}" CornerRadius="0,0,2,2" />
                                    <Border x:Name="SelectedLine" Grid.Row="1" Height="1" VerticalAlignment="Bottom" Margin="20,0,16,0"
                                            Background="{StaticResource LineBrush}" Visibility="Collapsed" />
                                </Grid>
                                <Grid x:Name="UnselectedLayer" Grid.RowSpan="2">
                                    <Border x:Name="UnselectedLine" Height="1" VerticalAlignment="Bottom" Margin="20,0,16,0"
                                            Background="{StaticResource LineBrush}" Visibility="Collapsed" />
                                </Grid>
                                <ContentPresenter Grid.RowSpan="2"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="Stretch"
                                                  Control.IsTemplateFocusTarget="True" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                Exp2: one continuous list.
                * Squiggly, full-width row lines that continue across groups.
                * Selection box and pill join across groups too.
                * Headers collapse; a tag marks where each group starts.
            -->
            <Style x:Key="Exp2HeaderStyle" TargetType="ListViewHeaderItem">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewHeaderItem">
                            <Grid />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Exp2ItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid x:Name="Root" Height="44" Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource HoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="UnselectedLayer.Visibility" Value="Collapsed" />
                                                <Setter Target="SelectedLayer.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="UnselectedLayer.Visibility" Value="Collapsed" />
                                                <Setter Target="SelectedLayer.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <VisualState.Setters>
                                                <Setter Target="UnselectedLayer.Visibility" Value="Collapsed" />
                                                <Setter Target="SelectedLayer.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="PreviousItemStates">
                                        <VisualState x:Name="NoPreviousItem">
                                            <VisualState.Setters>
                                                <Setter Target="GroupTag.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PreviousUnselectedSameGroup" />
                                        <VisualState x:Name="PreviousUnselectedOtherGroup">
                                            <VisualState.Setters>
                                                <Setter Target="GroupTag.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PreviousSelectedSameGroup">
                                            <VisualState.Setters>
                                                <Setter Target="BoxTop.CornerRadius" Value="0" />
                                                <Setter Target="PillTop.Margin" Value="4,0,0,0" />
                                                <Setter Target="PillTop.CornerRadius" Value="0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PreviousSelectedOtherGroup">
                                            <VisualState.Setters>
                                                <Setter Target="GroupTag.Visibility" Value="Visible" />
                                                <Setter Target="BoxTop.CornerRadius" Value="0" />
                                                <Setter Target="PillTop.Margin" Value="4,0,0,0" />
                                                <Setter Target="PillTop.CornerRadius" Value="0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="NextItemStates">
                                        <VisualState x:Name="NoNextItem" />
                                        <VisualState x:Name="NextUnselectedSameGroup">
                                            <VisualState.Setters>
                                                <Setter Target="UnselectedLine.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="NextUnselectedOtherGroup">
                                            <VisualState.Setters>
                                                <Setter Target="UnselectedLine.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="NextSelectedSameGroup">
                                            <VisualState.Setters>
                                                <Setter Target="BoxBottom.CornerRadius" Value="0" />
                                                <Setter Target="PillBottom.Margin" Value="4,0,0,0" />
                                                <Setter Target="PillBottom.CornerRadius" Value="0" />
                                                <Setter Target="SelectedLine.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="NextSelectedOtherGroup">
                                            <VisualState.Setters>
                                                <Setter Target="BoxBottom.CornerRadius" Value="0" />
                                                <Setter Target="PillBottom.Margin" Value="4,0,0,0" />
                                                <Setter Target="PillBottom.CornerRadius" Value="0" />
                                                <Setter Target="SelectedLine.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Grid x:Name="SelectedLayer" Grid.RowSpan="2" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Border x:Name="BoxTop" Background="{StaticResource BoxBrush}" CornerRadius="8,8,0,0" />
                                    <Border x:Name="BoxBottom" Grid.Row="1" Background="{StaticResource BoxBrush}" CornerRadius="0,0,8,8" />
                                    <Border x:Name="PillTop" Width="4" HorizontalAlignment="Left" Margin="4,8,0,0"
                                            Background="{StaticResource PillBrush}" CornerRadius="2,2,0,0" />
                                    <Border x:Name="PillBottom" Grid.Row="1" Width="4" HorizontalAlignment="Left" Margin="4,0,0,8"
                                            Background="{StaticResource PillBrush}" CornerRadius="0,0,2,2" />
                                    <Path x:Name="SelectedLine" Grid.Row="1" VerticalAlignment="Bottom" Margin="12,0,0,0"
                                          Stroke="{StaticResource PillBrush}" StrokeThickness="1" Visibility="Collapsed"
                                          Data="M0,3 q4,-4 8,0 t8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0" />
                                </Grid>
                                <Grid x:Name="UnselectedLayer" Grid.RowSpan="2">
                                    <Path x:Name="UnselectedLine" VerticalAlignment="Bottom"
                                          Stroke="{StaticResource LineBrush}" StrokeThickness="1" Visibility="Collapsed"
                                          Data="M0,3 q4,-4 8,0 t8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0 8,0" />
                                </Grid>
                                <ContentPresenter Grid.RowSpan="2"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="Stretch"
                                                  Control.IsTemplateFocusTarget="True" />
                                <TextBlock x:Name="GroupTag" Grid.RowSpan="2" Text="{Binding Content.Group, RelativeSource={RelativeSource TemplatedParent}}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                                           FontSize="12" Foreground="{StaticResource PillBrush}" Visibility="Collapsed" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Exp1: grouped" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Lines and selection stop at group boundaries." Foreground="#555555" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="Exp2: continuous" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Squiggly lines and selection run across groups." Foreground="#555555" TextWrapping="Wrap" />
        </StackPanel>

        <ListView x:Name="Exp1List" Grid.Row="1"
                  SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="False"
                  Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                  ItemsPanel="{StaticResource FlatPanel}"
                  ItemTemplate="{StaticResource ItemTemplate}"
                  ItemContainerStyle="{StaticResource Exp1ItemStyle}"
                  AutomationProperties.Name="Exp1">
            <ListView.GroupStyle>
                <GroupStyle HeaderContainerStyle="{StaticResource Exp1HeaderStyle}" />
            </ListView.GroupStyle>
        </ListView>
        <ListView x:Name="Exp2List" Grid.Row="1" Grid.Column="1"
                  SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="False"
                  Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                  ItemsPanel="{StaticResource FlatPanel}"
                  ItemTemplate="{StaticResource ItemTemplate}"
                  ItemContainerStyle="{StaticResource Exp2ItemStyle}"
                  AutomationProperties.Name="Exp2">
            <ListView.GroupStyle>
                <GroupStyle HeaderContainerStyle="{StaticResource Exp2HeaderStyle}" />
            </ListView.GroupStyle>
        </ListView>
    </Grid>
</Window>
